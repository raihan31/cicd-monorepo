{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "bundler",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "esModuleInterop": true,
    "importHelpers": true,
    "target": "ES2022",
    "module": "ES2022",
    "lib": ["ES2022", "DOM"],
    "skipLibCheck": true,
    "paths": {
      "@cicd-monorepo/shared-contracts": [
        "./libs/shared/contracts/src/index.ts"
      ]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
