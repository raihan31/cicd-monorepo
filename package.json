{
  "name": "cicd-monorepo",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0",
    "npm": ">=10.9.3"
  },
  "scripts": {
    "start:web": "nx serve web",
    "start:api": "nx serve api",
    "lint": "nx run-many -t lint",
    "test": "nx run-many -t test",
    "build": "nx run-many -t build",
    "validate": "nx run-many -t lint test build",
    "affected": "nx affected -t lint test build",
    "graph": "nx graph",
    "affected:list": "nx show projects --affected",
    "affected:lint": "nx affected -t lint",
    "affected:test": "nx affected -t test",
    "affected:build": "nx affected -t build",
    "affected:validate": "nx affected -t lint test build",
    "test:coverage": "nx run-many -t test --coverage",
    "test:coverage:web": "nx test web --coverage",
    "test:coverage:api": "nx test api --coverage",
    "affected:test:coverage": "nx affected -t test --coverage",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up --build",
    "docker:up:detached": "docker compose up --build --detach",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs --follow",
    "docker:ps": "docker compose ps",
    "docker:test": "npm run docker:up:detached && node scripts/test-containers.mjs",
    "deploy:dev": "docker compose -f deployment/development/compose.yaml up -d",
    "deploy:dev:down": "docker compose -f deployment/development/compose.yaml down",
    "deploy:staging": "docker compose -f deployment/staging/compose.yaml up -d",
    "deploy:staging:down": "docker compose -f deployment/staging/compose.yaml down",
    "verify:dev": "APP_ENV=development node scripts/verify-deployment.mjs",
    "verify:staging": "APP_ENV=staging node scripts/verify-deployment.mjs"
  },
  "dependencies": {
    "@angular/common": "^22.0.8",
    "@angular/compiler": "^22.0.8",
    "@angular/core": "^22.0.8",
    "@angular/forms": "^22.0.8",
    "@angular/platform-browser": "^22.0.8",
    "@angular/router": "^22.0.8",
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "tslib": "^2.8.1",
    "zone.js": "^0.15.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^22.0.7",
    "@angular-devkit/core": "^22.0.7",
    "@angular-devkit/schematics": "^22.0.7",
    "@angular/build": "^22.0.7",
    "@angular/cli": "^22.0.7",
    "@angular/compiler-cli": "^22.0.8",
    "@eslint/js": "^9.31.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.1.0",
    "@nx/angular": "23.1.0",
    "@nx/eslint": "23.1.0",
    "@nx/eslint-plugin": "23.1.0",
    "@nx/jest": "23.1.0",
    "@nx/js": "23.1.0",
    "@nx/nest": "23.1.0",
    "@nx/node": "23.1.0",
    "@nx/webpack": "23.1.0",
    "@nx/workspace": "23.1.0",
    "@types/express": "^5.0.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.15.0",
    "eslint": "^9.31.0",
    "eslint-config-prettier": "^10.1.5",
    "jest": "^30.0.4",
    "jest-environment-jsdom": "^30.0.4",
    "jest-environment-node": "^30.0.4",
    "jest-junit": "^17.0.0",
    "jest-preset-angular": "^17.0.0",
    "nx": "23.1.0",
    "prettier": "^3.6.2",
    "ts-jest": "^29.4.0",
    "ts-node": "^10.9.2",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.38.0",
    "webpack-cli": "^6.0.1"
  }
}
